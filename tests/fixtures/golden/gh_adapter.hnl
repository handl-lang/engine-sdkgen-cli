--- Generated adapter for gh-cli-host/gh

from "cli-c" import { run, argv }
from "../gh" import { GhPrCreate, GhPrList }

gh_pr_create_flags := [{ name: "draft", flag: "--draft", kind: "flag", doc: "" }, { name: "label", flag: "--label", kind: "strings", doc: "" }, { name: "title", flag: "--title", kind: "string", doc: "PR title" }]

export gh_pr_create: GhPrCreate := (branch, opts, extras) ~> do {
  run(argv("gh", ["pr", "create"], [branch], gh_pr_create_flags, opts, extras))
}

gh_pr_list_flags := []

export gh_pr_list: GhPrList := () ~> do {
  run(argv("gh", ["pr", "list"], [], gh_pr_list_flags, null, []))
}
